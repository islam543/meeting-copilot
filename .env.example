# Copy this file to .env and fill it in. Without it, speech-to-text runs on the laptop (slower).

# Free key from console.groq.com. When set, speech-to-text runs on Groq's servers (fast, large Whisper model).
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3

# Speech-to-text engine. Blank = groq if GROQ_API_KEY is set, else whisper.
# groq = Groq's servers. whisper = on this laptop, free but slower. soniox = paid, with speaker labels.
STT_ENGINE=
# Laptop model: small keeps up live; medium is more accurate but falls behind on this laptop.
WHISPER_MODEL=small
# Only needed with STT_ENGINE=soniox.
SONIOX_API_KEY=

# Leave blank to use your Claude subscription through Claude Code (you must be logged in to Claude Code).
# Fill it in to use the Claude API instead (faster, billed per use).
ANTHROPIC_API_KEY=

# Languages people speak in the meeting.
LANGUAGES=ar,en
# Language the suggestions are written in.
OUTPUT_LANGUAGE=English

# Automatic suggestions at most this often, in seconds. 0 = only when you press the help key.
AUTO_NUDGE_SECONDS=45

# Blank = Windows default microphone. Run "python copilot.py --devices" to see the numbers.
MIC_DEVICE=

HELP_HOTKEY=<f9>
ME_HOTKEY=<f8>
SPEECH_HOTKEY=<f10>

# Models: fast one for automatic suggestions, stronger one for the help key and the notes.
NUDGE_MODEL=claude-haiku-5-5
HELP_MODEL=claude-sonnet-5-5
SUMMARY_MODEL=claude-opus-5-5
